{
    "name": "chattrn/connector",
    "description": "Serves the Chattrn API (devspec.txt: \"Slice 3: Laravel package installer\") from your own Laravel store, so Chattrn can read products, stock and orders the same way it reads a native Chattrn API or Shopify store.",
    "type": "library",
    "license": "MIT",
    "keywords": ["chattrn", "laravel", "ecommerce", "api"],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Chattrn\\Connector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chattrn\\Connector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chattrn\\Connector\\ChattrnServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
